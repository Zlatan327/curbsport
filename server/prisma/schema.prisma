datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model School {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  institutionType String  @map("institution_type")
  pitches         Pitch[]
  users           User[]

  @@index([institutionType])
}

model User {
  id               Int      @id @default(autoincrement())
  alias            String   @unique
  passwordHash     String   @map("password_hash")
  schoolId         Int      @map("school_id")
  school           School   @relation(fields: [schoolId], references: [id])
  favoritePosition String   @default("Midfielder") @map("favorite_position")
  reputationScore  Int      @default(10) @map("reputation_score")
  matchesPlayed    Int      @default(0) @map("matches_played")
  goalsScored      Int      @default(0) @map("goals_scored")
  manOfTheMatch    Int      @default(0) @map("man_of_the_match")
  createdAt        DateTime @default(now()) @map("created_at")

  createdPitches   Pitch[]         @relation("PitchCreator")
  hostedLobbies    MatchLobby[]    @relation("LobbyHost")
  lobbyMemberships LobbyMember[]
  banterMessages   BanterMessage[]
  pitchVotes       PitchVote[]
  favoritePitches    FavoritePitch[]
  footballPosition   FootballPosition?  @map("football_position")
  basketballPosition BasketballPosition? @map("basketball_position")
  heightCm           Int?               @map("height_cm")
  weightKg           Int?               @map("weight_kg")
  primarySport       SportType          @default(FOOTBALL) @map("primary_sport")
  medicalInfo        String?            @map("medical_info")
  avatarUrl          String?            @map("avatar_url")
  hasBall            Boolean            @default(false) @map("has_ball")
  ballType           String?            @map("ball_type")
  lastSchoolChangeAt DateTime?          @map("last_school_change_at")
  lastAliasChangeAt  DateTime?          @map("last_alias_change_at")
  physicalHistory    PhysicalStatHistory[]
  matchStats         MatchStat[]
  matchConfirmations MatchConfirmation[]
  slashesReceived    SlashRecord[]      @relation("SlashedUser")
  slashesIssued      SlashRecord[]      @relation("SlashIssuer")
  crownBannedUntil   DateTime?          @map("crown_banned_until")
  matchResults       MatchResult[]      @relation("MatchResultSubmitter")
  directionsUploaded PitchDirection[]
  directionVerifications PitchDirectionVerification[]
}

model PhysicalStatHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm    Int?     @map("height_cm")
  weightKg    Int?     @map("weight_kg")
  medicalInfo String?  @map("medical_info")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
}

model FavoritePitch {
  userId  Int      @map("user_id")
  pitchId Int      @map("pitch_id")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pitch   Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now()) @map("added_at")

  @@id([userId, pitchId])
}

model Pitch {
  id                  Int                @id @default(autoincrement())
  name                String
  fieldType           String             @map("field_type")
  priceBracket        String             @map("price_bracket")
  schoolId            Int                @map("school_id")
  school              School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  landmarkDescription String             @map("landmark_description")
  latitude            Decimal?           @db.Decimal(9, 6)
  longitude           Decimal?           @db.Decimal(9, 6)
  verificationStatus  VerificationStatus @default(GHOST) @map("verification_status")
  confirmationCount   Int                @default(0) @map("confirmation_count")
  imageUrl            String?            @map("image_url")
  activeStatus        PitchActiveStatus  @default(UNKNOWN) @map("active_status")
  hasBallNow          Boolean            @default(false) @map("has_ball_now")
  ballBroughtBy       String?            @map("ball_brought_by")
  ballReportedAt      DateTime?          @map("ball_reported_at")
  createdById         Int?               @map("created_by")
  createdBy           User?              @relation("PitchCreator", fields: [createdById], references: [id])
  createdAt           DateTime           @default(now()) @map("created_at")

  lobbies         MatchLobby[]
  banterMessages  BanterMessage[]
  votes           PitchVote[]
  favoritedBy     FavoritePitch[]
  sportType       SportType @default(FOOTBALL) @map("sport_type")
  matchResults    MatchResult[]
  directions      PitchDirection[]
}

enum VerificationStatus {
  GHOST
  COMMUNITY_VERIFIED
  FLAGGED
}

enum PitchActiveStatus {
  UNKNOWN
  DRY
  BUILDING
  LIVE
}

model MatchLobby {
  id          Int         @id @default(autoincrement())
  pitchId     Int         @map("pitch_id")
  pitch       Pitch       @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  hostUserId  Int         @map("host_user_id")
  host        User        @relation("LobbyHost", fields: [hostUserId], references: [id])
  teamName    String?     @map("team_name")
  maxPlayers  Int         @default(10) @map("max_players")
  scheduledAt DateTime    @map("scheduled_at")
  status      LobbyStatus @default(BUILDING)
  hasBall     Boolean     @default(false) @map("has_ball")
  createdAt   DateTime    @default(now()) @map("created_at")

  sportType   SportType @default(FOOTBALL) @map("sport_type")
  matchResult MatchResult?

  members LobbyMember[]
}

enum LobbyStatus {
  BUILDING
  FULL
  ACTIVE
  COMPLETED
  CANCELLED
}

model LobbyMember {
  lobbyId  Int        @map("lobby_id")
  lobby    MatchLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  userId   Int        @map("user_id")
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now()) @map("joined_at")

  @@id([lobbyId, userId])
}

model BanterMessage {
  id        Int      @id @default(autoincrement())
  pitchId   Int      @map("pitch_id")
  pitch     Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now()) @map("created_at")
}

model PitchVote {
  id      Int      @id @default(autoincrement())
  pitchId Int      @map("pitch_id")
  pitch   Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  userId  Int      @map("user_id")
  user    User     @relation(fields: [userId], references: [id])
  isUp    Boolean  @map("is_up")
  votedAt DateTime @default(now()) @map("voted_at")

  @@unique([pitchId, userId])
}

enum SportType {
  FOOTBALL
  BASKETBALL
}

enum MatchResultStatus {
  PENDING
  CONFIRMED
  DISPUTED
  SLASHED
}

enum FootballPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum BasketballPosition {
  GUARD
  FORWARD
  CENTER
}

model MatchResult {
  id            Int               @id @default(autoincrement())
  lobbyId       Int               @unique @map("lobby_id")
  lobby         MatchLobby        @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  pitchId       Int               @map("pitch_id")
  pitch         Pitch             @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  submittedById Int               @map("submitted_by")
  submittedBy   User              @relation("MatchResultSubmitter", fields: [submittedById], references: [id])
  sportType     SportType         @map("sport_type")
  status        MatchResultStatus @default(PENDING)
  matchDate     DateTime          @map("match_date")
  durationMins  Int               @map("duration_mins")
  playerCount   Int               @map("player_count")
  createdAt     DateTime          @default(now()) @map("created_at")

  stats         MatchStat[]
  confirmations MatchConfirmation[]
  slashRecords  SlashRecord[]

  @@index([pitchId])
  @@index([submittedById])
}

model MatchStat {
  id            Int         @id @default(autoincrement())
  matchResultId Int         @map("match_result_id")
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  userId        Int         @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  
  // Football stats
  goals         Int         @default(0)
  assists       Int         @default(0)
  cleanSheets   Int         @default(0) @map("clean_sheets")
  saves         Int         @default(0)
  tackles       Int         @default(0)
  
  // Basketball stats
  points        Int         @default(0)
  rebounds      Int         @default(0)
  steals        Int         @default(0)
  blocks        Int         @default(0)
  threePointers Int         @default(0) @map("three_pointers")
  
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([matchResultId, userId])
  @@index([userId])
}

model MatchConfirmation {
  id            Int         @id @default(autoincrement())
  matchResultId Int         @map("match_result_id")
  matchResult   MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  userId        Int         @map("user_id")
  user          User        @relation(fields: [userId], references: [id])
  confirmed     Boolean
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([matchResultId, userId])
}

model SlashRecord {
  id              Int         @id @default(autoincrement())
  matchResultId   Int         @map("match_result_id")
  matchResult     MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  slashedUserId   Int         @map("slashed_user_id")
  slashedUser     User        @relation("SlashedUser", fields: [slashedUserId], references: [id])
  issuedByUserId  Int         @map("issued_by_user_id")
  issuedBy        User        @relation("SlashIssuer", fields: [issuedByUserId], references: [id])
  reason          String
  repPenalty      Int         @map("rep_penalty")
  statMultiplier  Float       @default(2.0) @map("stat_multiplier")
  crownBanDays    Int         @default(14) @map("crown_ban_days")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([slashedUserId])
}

model PitchDirection {
  id                Int       @id @default(autoincrement())
  pitchId           Int       @map("pitch_id")
  pitch             Pitch     @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  userId            Int       @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  directions        String    @db.Text
  landmarks         String?   @db.Text
  transitTip        String?   @map("transit_tip")
  verificationCount Int       @default(0) @map("verification_count")
  isVerified        Boolean   @default(false) @map("is_verified")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  verifications     PitchDirectionVerification[]

  @@index([pitchId])
}

model PitchDirectionVerification {
  id          Int            @id @default(autoincrement())
  directionId Int            @map("direction_id")
  direction   PitchDirection @relation(fields: [directionId], references: [id], onDelete: Cascade)
  userId      Int            @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([directionId, userId])
}
